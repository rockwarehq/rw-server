{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // Published package: pin ES2023 emit, no sourcemaps, no ambient node
    // types so dist output stays identical to the pre-base-config artifact.
    "target": "ES2023",
    "lib": ["ES2023"],
    // Not yet clean under the base's checked index access (same opt-out as
    // auth/historian/livestore/services).
    "noUncheckedIndexedAccess": false,
    "sourceMap": false,
    "types": [],
    "outDir": "dist",
    "rootDir": "src"
  },
  "include": ["src"]
}
