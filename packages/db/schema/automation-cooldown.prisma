/// When an automation last fired per cooldown scope — shared by every api instance.
model AutomationCooldown {
  automationId String     @db.Uuid
  automation   Automation @relation(fields: [automationId], references: [id], onDelete: Cascade)
  /// The event's cooldown scope value (a station id, a group id, ...); "" = per automation.
  scope        String
  firedAt      DateTime   @db.Timestamptz(3)

  @@id([automationId, scope])
}
