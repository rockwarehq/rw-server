model DisplayRefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  tokenHash String    @unique
  expiresAt DateTime  @db.Timestamptz(3)
  revokedAt DateTime? @db.Timestamptz(3)
  // See RefreshToken.rotatedAt: rotation marker enabling the reuse grace window.
  rotatedAt DateTime? @db.Timestamptz(3)
  userAgent String?
  ipAddress String?

  createdAt DateTime @default(now()) @db.Timestamptz(3)

  displayId String  @db.Uuid
  display   Display @relation(fields: [displayId], references: [id], onDelete: Cascade)

  @@index([displayId])
}
