/// Bucket-based access control for the User principal tier.
///
/// Rows live in containers; access is membership in the container:
/// - PLANT bucket (one per site): everyone at the plant is a member.
///   VIEW = read the common plant things. MANAGE = write the plant and
///   everything in it (cascades to every workcenter). ADMIN = the reserved
///   shelf: people, access administration, dangerous settings.
/// - WORKCENTER bucket (one per workcenter): the crew.
///   VIEW = watch the cell's floor. MANAGE = operate and configure it.
/// Workspace owners (WorkspaceMembership.workspaceRole = OWNER) and
/// Rockware staff bypass buckets. Evaluated in code:
/// packages/auth/src/iam/buckets.ts.

/// Internal Rockware staff. Users with a SystemRole resolve access from
/// code (SUPPORT = read everywhere, ENGINEER = manage/admin everywhere);
/// they never appear as members of a customer workspace.
enum SystemRole {
  SUPPORT
  ENGINEER
}

enum BucketKind {
  PLANT // one per site: everyone at the plant is a member
  WORKCENTER // one per workcenter: the crew's bucket
}

enum BucketTier {
  VIEW // Plant: member (read the common things). Workcenter: watch the floor.
  MANAGE // Plant: write the plant and everything in it. Workcenter: operate and configure the cell.
  ADMIN // Plant only: people, access administration, dangerous settings.
}

model Bucket {
  id          String     @id @default(uuid()) @db.Uuid
  workspaceId String     @db.Uuid
  /// Null only never — every bucket belongs to a site today; kept nullable
  /// so a future workspace-level container needs no migration.
  siteId      String?    @db.Uuid
  kind        BucketKind
  /// Set exactly when kind = WORKCENTER.
  workcenterId String?   @unique @db.Uuid
  name        String

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  workspace  Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  site       Site?       @relation(fields: [siteId], references: [id], onDelete: Cascade)
  workcenter Workcenter? @relation(fields: [workcenterId], references: [id], onDelete: Cascade)
  accesses   BucketAccess[]

  @@index([siteId, kind])
  @@index([workspaceId])
}

model BucketAccess {
  id           String     @id @default(uuid()) @db.Uuid
  bucketId     String     @db.Uuid
  membershipId String     @db.Uuid
  tier         BucketTier

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  bucket     Bucket              @relation(fields: [bucketId], references: [id], onDelete: Cascade)
  membership WorkspaceMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  @@unique([bucketId, membershipId])
  @@index([membershipId])
}

// ─── ARCHIVED (pre-bucket access model) ──────────────────────────────────
// The role/permission era: Role rows carried permission-string arrays,
// RoleAssignment linked memberships to them, WorkcenterGrant was the flat
// per-workcenter grant. The bucket migration compiled all of it into
// Bucket/BucketAccess rows and workspaceRole. These tables are kept as a
// frozen audit/rollback archive — NO code reads or writes them.

enum RoleScope {
  WORKSPACE
  SITE
}

/// ARCHIVED — see the bucket migration. No code paths.
model Role {
  id          String    @id @default(uuid()) @db.Uuid
  workspaceId String    @db.Uuid
  name        String
  description String?
  scope       RoleScope
  permissions String[]
  legacyPermissions Json?
  isSystem    Boolean   @default(false)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  workspace   Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  assignments RoleAssignment[]

  @@unique([workspaceId, name, scope])
  @@index([workspaceId])
}

enum WorkcenterAccess {
  READ
  WRITE
}

/// ARCHIVED — compiled into WORKCENTER BucketAccess rows. No code paths.
model WorkcenterGrant {
  id           String           @id @default(uuid()) @db.Uuid
  membershipId String           @db.Uuid
  workcenterId String           @db.Uuid
  access       WorkcenterAccess

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  membership WorkspaceMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  workcenter Workcenter          @relation(fields: [workcenterId], references: [id], onDelete: Cascade)

  @@unique([membershipId, workcenterId])
  @@index([workcenterId])
}

/// ARCHIVED — compiled into Plant BucketAccess rows / workspaceRole. No code paths.
model RoleAssignment {
  id           String @id @default(uuid()) @db.Uuid
  membershipId String @db.Uuid
  roleId       String @db.Uuid

  siteId String? @db.Uuid

  createdAt DateTime @default(now()) @db.Timestamptz(3)

  membership WorkspaceMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  role       Role                @relation(fields: [roleId], references: [id], onDelete: Cascade)
  site       Site?               @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@index([membershipId])
  @@index([siteId])
}
