/// Role-based access control for the User principal tier.
///
/// Permissions are `resource:action` strings defined in code (src/iam/permissions.ts),
/// not stored here. Roles carry an array of those strings.
///
/// A Role belongs to a Workspace and is either workspace-scoped or site-scoped.
/// A RoleAssignment links a WorkspaceMembership to a Role, optionally narrowed
/// to one Site.

enum RoleScope {
  WORKSPACE
  SITE
}

/// Internal Rockware staff. Users with a SystemRole resolve permissions from
/// code (SYSTEM_ROLE_PERMISSIONS) rather than RoleAssignment rows; they never
/// appear as members of a customer workspace.
enum SystemRole {
  SUPPORT
  ENGINEER
}

model Role {
  id          String    @id @default(uuid()) @db.Uuid
  workspaceId String    @db.Uuid
  name        String
  description String?
  scope       RoleScope
  permissions String[]
  /// Exact permission array as it was before the vocabulary expand
  /// migration copied it here. Review aid and rollback source while both
  /// permission vocabularies exist; removed when the legacy keys go away.
  legacyPermissions Json?
  isSystem    Boolean   @default(false)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  workspace   Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  assignments RoleAssignment[]

  @@unique([workspaceId, name, scope])
  @@index([workspaceId])
}

enum WorkcenterAccess {
  READ
  WRITE
}

/// GitHub-collaborator-style grant: a membership gets READ or WRITE at one
/// workcenter, independent of (and unioned with) any site role. Evaluated in
/// code (packages/auth/src/iam/permissions.ts), never through Role rows.
model WorkcenterGrant {
  id           String           @id @default(uuid()) @db.Uuid
  membershipId String           @db.Uuid
  workcenterId String           @db.Uuid
  access       WorkcenterAccess

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  membership WorkspaceMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  workcenter Workcenter          @relation(fields: [workcenterId], references: [id], onDelete: Cascade)

  @@unique([membershipId, workcenterId])
  @@index([workcenterId])
}

model RoleAssignment {
  id           String @id @default(uuid()) @db.Uuid
  membershipId String @db.Uuid
  roleId       String @db.Uuid

  siteId String? @db.Uuid

  createdAt DateTime @default(now()) @db.Timestamptz(3)

  membership WorkspaceMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  role       Role                @relation(fields: [roleId], references: [id], onDelete: Cascade)
  site       Site?               @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@index([membershipId])
  @@index([siteId])
}

// ─── SPIKE: Basecamp-bucket access model (throwaway exploration) ─────────
// Every row belongs to exactly one bucket; a person's access is the set of
// buckets they are in, each with a small tier. No permission vocabulary.
// Scalar columns only (FKs live in the spike migration) to keep the spike
// diff small. See SPIKE.md on this branch.

enum BucketKind {
  PLANT // one per site: everyone at the plant is a member
  WORKCENTER // one per workcenter: the crew's floor bucket
}

enum BucketTier {
  VIEW // Plant: member (read the common things). Workcenter: watch the floor.
  WORK // Workcenter only: operate the cell.
  MANAGE // Plant: write the plant and everything in it (cascades to every workcenter).
  ADMIN // Plant only: the reserved shelf — people, access, dangerous settings.
}

model Bucket {
  id          String     @id @default(uuid()) @db.Uuid
  workspaceId String     @db.Uuid
  siteId      String?    @db.Uuid
  kind        BucketKind
  /// Set only for kind = WORKCENTER.
  workcenterId String?   @unique @db.Uuid
  name        String

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  accesses BucketAccess[]

  @@index([siteId, kind])
  @@index([workspaceId])
}

model BucketAccess {
  id           String     @id @default(uuid()) @db.Uuid
  bucketId     String     @db.Uuid
  membershipId String     @db.Uuid
  tier         BucketTier

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  bucket Bucket @relation(fields: [bucketId], references: [id], onDelete: Cascade)

  @@unique([bucketId, membershipId])
  @@index([membershipId])
}
