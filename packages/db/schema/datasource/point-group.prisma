model PointGroup {
  id          String  @id @default(uuid()) @db.Uuid
  name        String
  description String?
  pollRateMs  Int     @default(1000)
  /// Null: publish each point when it changes. Set: publish every point's latest
  /// value on a clock-aligned tick this many ms apart, then the group's tick point.
  publishIntervalMs Int?
  config      Json    @default("{}")

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  datasourceId String     @db.Uuid
  datasource   Datasource @relation(fields: [datasourceId], references: [id], onDelete: Cascade)

  points Point[]
}
