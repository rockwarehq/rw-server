enum CycleStatus {
  DISCARD
  BAD
  GOOD
}

model Cycle {
  id           String      @id @default(uuid()) @db.Uuid
  rejectNumber Int         @default(0)
  cycleStatus  CycleStatus

  // Timing
  start          DateTime  @db.Timestamptz(3)
  end            DateTime? @db.Timestamptz(3)
  equipmentStart DateTime? @db.Timestamptz(3)
  equipmentEnd   DateTime? @db.Timestamptz(3)

  /// Actual quantity this cycle: measured from the event, else the standard quantity; null = discrete.
  quantity     Decimal? @db.Decimal(18, 4)
  quantityUnit String   @default("")

  /// Earned standard (s) snapshotted at record time — the cycle is self-contained for KPI math.
  standardCycle Decimal? @db.Decimal(10, 2)

  /// Expected quantity this cycle (pulse size, or rate × interval).
  standardQuantity Decimal? @db.Decimal(18, 4)

  attrs Json @default("{}")

  // Livestore hook-event id that produced this cycle — unique so a
  // redelivered event records at most one cycle.
  sourceEventId String? @unique @db.Uuid

  siteId String @db.Uuid
  site   Site   @relation(fields: [siteId], references: [id])

  stationId String  @db.Uuid
  station   Station @relation(fields: [stationId], references: [id])

  // ── Dimension snapshots (star pattern for BI), captured at record time ──
  workcenterId String?     @db.Uuid
  workcenter   Workcenter? @relation(fields: [workcenterId], references: [id], onDelete: SetNull)

  /// Stable job id paired with the jobVersionId snapshot below.
  jobId String? @db.Uuid
  job   Job?    @relation(fields: [jobId], references: [id], onDelete: SetNull)

  /// Shift the cycle recorded in (resolved at cycle end).
  shiftInstanceId String?        @db.Uuid
  shiftInstance   ShiftInstance? @relation(fields: [shiftInstanceId], references: [id], onDelete: SetNull)

  /// Business date of that shift.
  businessDate DateTime? @db.Date

  orderId String?    @db.Uuid
  order   WorkOrder? @relation(fields: [orderId], references: [id])

  // Snapshot: version IDs at point in time
  stationVersionId String?         @db.Uuid
  stationVersion   StationVersion? @relation(fields: [stationVersionId], references: [id])

  jobVersionId String     @db.Uuid
  jobVersion   JobVersion @relation(fields: [jobVersionId], references: [id])

  /// Production mode the station was in when the cycle recorded.
  modeId String?         @db.Uuid
  mode   ProductionMode? @relation(fields: [modeId], references: [id], onDelete: SetNull)

  /// Set when a job history amendment rewrote this cycle's job; null = as recorded.
  amendmentId String?              @db.Uuid
  amendment   JobHistoryAmendment? @relation(fields: [amendmentId], references: [id], onDelete: SetNull)

  toolVersions ToolVersion[]

  jobTools JobTool[]

  inventoryItems      InventoryItem[]
  itemDispositionLogs ItemDispositionLog[]

  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @db.Timestamptz(3)
  deletedAt DateTime? @db.Timestamptz(3)

  @@index([stationId, end])
  @@index([siteId, end])
  @@index([siteId, deletedAt, end])
  @@index([stationId, deletedAt, end])
  @@index([jobVersionId])
  @@index([orderId])
  @@index([modeId])
  @@index([amendmentId])
  // Star stamps: [siteId, businessDate] serves BI date slicing; shiftInstanceId
  // and workcenterId back their SetNull FKs (shift rematerialization deletes
  // instances routinely). Per-dimension indexes are deferred until a real
  // query needs them — this is the hottest insert table.
  @@index([siteId, businessDate])
  @@index([shiftInstanceId])
  @@index([workcenterId])
}
