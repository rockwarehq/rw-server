enum CycleStatus {
  DISCARD
  BAD
  GOOD
}

model Cycle {
  id           String      @id @default(uuid()) @db.Uuid
  rejectNumber Int         @default(0)
  cycleStatus  CycleStatus

  // Timing
  start          DateTime  @db.Timestamptz(3)
  end            DateTime? @db.Timestamptz(3)
  equipmentStart DateTime? @db.Timestamptz(3)
  equipmentEnd   DateTime? @db.Timestamptz(3)

  attrs Json @default("{}")

  // Livestore hook-event id that produced this cycle — unique so a
  // redelivered event records at most one cycle.
  sourceEventId String? @unique @db.Uuid

  siteId String @db.Uuid
  site   Site   @relation(fields: [siteId], references: [id])

  stationId String  @db.Uuid
  station   Station @relation(fields: [stationId], references: [id])

  orderId String?    @db.Uuid
  order   WorkOrder? @relation(fields: [orderId], references: [id])

  // Snapshot: version IDs at point in time
  stationVersionId String?         @db.Uuid
  stationVersion   StationVersion? @relation(fields: [stationVersionId], references: [id])

  jobVersionId String     @db.Uuid
  jobVersion   JobVersion @relation(fields: [jobVersionId], references: [id])

  // Conformed context, stamped at completion inside the cycle.complete()
  // transaction. Nullable: a cycle is never dropped because context
  // resolution failed — stamp NULL and repair via restampWindow.
  workcenterId String?     @db.Uuid
  workcenter   Workcenter? @relation(fields: [workcenterId], references: [id])

  shiftInstanceId String?        @db.Uuid
  shiftInstance   ShiftInstance? @relation(fields: [shiftInstanceId], references: [id])

  /// Plant calendar day: ShiftInstance.businessDate when resolved, else the
  /// site-timezone local date of `start`.
  businessDate DateTime? @db.Date

  /// Parent of jobVersionId — version for history-correct math, parent for grouping.
  jobId String? @db.Uuid
  job   Job?    @relation(fields: [jobId], references: [id])

  /// Open StationLogonSession at completion — operator attribution.
  logonSessionId String?              @db.Uuid
  logonSession   StationLogonSession? @relation(fields: [logonSessionId], references: [id])

  /// Primary mold (parent + version pair). The toolVersions m2m remains for
  /// multi-tool cycles; this pair is the reporting dimension.
  toolId String? @db.Uuid
  tool   Tool?   @relation(fields: [toolId], references: [id])

  toolVersionId String?      @db.Uuid
  toolVersion   ToolVersion? @relation("CyclePrimaryToolVersion", fields: [toolVersionId], references: [id])

  toolVersions ToolVersion[]

  jobTools JobTool[]

  inventoryItems      InventoryItem[]
  itemDispositionLogs ItemDispositionLog[]

  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @db.Timestamptz(3)
  deletedAt DateTime? @db.Timestamptz(3)

  @@index([stationId, end])
  @@index([siteId, end])
  @@index([siteId, deletedAt, end])
  @@index([stationId, deletedAt, end])
  @@index([jobVersionId])
  @@index([orderId])
  @@index([siteId, businessDate])
  @@index([shiftInstanceId])
  @@index([jobId, start])
}
