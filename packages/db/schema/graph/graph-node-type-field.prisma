model GraphNodeTypeField {
  id           String  @id @default(uuid()) @db.Uuid
  typeId       String  @db.Uuid
  key          String
  label        String
  description  String?
  valueType    String
  required     Boolean @default(false)
  resolverType String
  resolver     Json
  sampleRateMs Int?
  sortOrder    Int     @default(0)
  isDeleted    Boolean @default(false)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  type GraphNodeType @relation(fields: [typeId], references: [id], onDelete: Cascade)

  @@unique([typeId, key])
  @@index([typeId])
  @@index([isDeleted])
}
