enum AuditAction {
  // User invitations
  USER_INVITED
  INVITE_VERIFIED // not written: invites complete through the password reset (INVITE_COMPLETED)
  INVITE_COMPLETED
  INVITE_FAILED // not written: invites complete through the password reset (INVITE_COMPLETED)
  INVITE_EXPIRED
  INVITE_REVOKED

  // Password reset
  PASSWORD_RESET_REQUESTED
  PASSWORD_RESET_COMPLETED
  PASSWORD_RESET_FAILED

  // Authentication
  LOGIN_SUCCESS
  LOGIN_FAILED
  LOGIN_LOCKED
  LOGOUT
  ACCOUNT_UNLOCKED
  REFRESH_REUSE_GRACE
  REFRESH_REUSE_DETECTED

  // Account changes
  PASSWORD_CHANGED
  PASSWORD_ADMIN_RESET
  USER_DISABLED
  USER_ENABLED

  // Operator logon
  OPERATOR_LOGON
  OPERATOR_LOGOFF
  OPERATOR_LOGON_FAILED
  OPERATOR_SUPERVISOR_CHALLENGE // not written: supervisor approval is not built
  OPERATOR_SUPERVISOR_CHALLENGE_FAILED // not written: supervisor approval is not built

  // Customer/app API tokens
  API_TOKEN_CREATED
  API_TOKEN_REVOKED

  // Graph changesets
  GRAPH_CHANGESET_APPLIED

  // Agents connected over OAuth (MCP)
  OAUTH_GRANT_CREATED
  OAUTH_GRANT_REVOKED
  AGENT_CONNECTIONS_POLICY_CHANGED

  // Setup changesets (bulk master data)
  SETUP_CHANGESET_PROPOSED
  SETUP_CHANGESET_REPLANNED
  SETUP_CHANGESET_REVISED
  SETUP_CHANGESET_APPLIED
  SETUP_CHANGESET_DISCARDED
  SETUP_CHANGESET_ROLLED_BACK
  SETUP_CHANGESET_CLEARED
}

// The audit trail: who did what, when, where from, and to which record.
// Append-only. Who, the plant, IP, user agent and how they came in are filled
// from the request's audit context (packages/services/src/audit/context.ts).
model AuditLog {
  id          String      @id @default(uuid()) @db.Uuid
  action      AuditAction
  userId      String?     @db.Uuid // The person the event is about (may be null for failed lookups)
  actorId     String?     @db.Uuid // Who did it (null for anonymous, e.g. a failed login)
  workspaceId String?     @db.Uuid
  siteId      String?     @db.Uuid // The plant it happened in, when it belongs to one
  entityType  String? // The record it happened to, e.g. "product"
  entityId    String?
  changes     Json? // { field: { from, to } }, never secrets
  via         String? // ui | staff | display | api-token | system | agent:<client name>
  requestId   String? // Ties together the entries one request wrote
  ipAddress   String?
  userAgent   String?
  metadata    Json? // Additional context (e.g., reason, attempts count)
  createdAt   DateTime    @default(now()) @db.Timestamptz(3)

  @@index([userId])
  @@index([actorId, createdAt])
  @@index([action])
  @@index([createdAt])
  @@index([workspaceId, createdAt])
  @@index([siteId, createdAt])
  @@index([entityType, entityId, createdAt])
}
