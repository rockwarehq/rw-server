model EmployeeRole {
  id          String   @id @default(uuid()) @db.Uuid
  name        String
  permissions String[] @default([])

  siteId String @db.Uuid
  site   Site   @relation(fields: [siteId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  siteAccess EmployeeSiteAccess[]

  openCallDefinitions   CallDefinition[] @relation("CallDefinitionOpenRoles")
  answerCallDefinitions CallDefinition[] @relation("CallDefinitionAnswerRoles")
  productionModes       ProductionMode[] @relation("ProductionModeRoles")

  @@unique([siteId, name])
  @@index([siteId])
}
