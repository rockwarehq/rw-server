// The schema is split into one file per model. Each file also holds that
// model's enums. A folder groups a model with the models that only exist to
// serve it (station/ holds station, station-version, station-state-log...).
// Models with no such family stay here.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated"
  moduleFormat = "esm"
}

generator json {
  provider  = "prisma-json-types-generator"
  namespace = "PrismaJson"
}

datasource db {
  provider = "postgresql"
}
