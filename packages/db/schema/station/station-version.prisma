/// How a machine's signal counts (ADR-0017 names in brackets).
/// DISCRETE [Count by cycle]: each signal is one cycle, timed against the
/// standard cycle; item counts come from job products.
/// QUANTITY_PER_CYCLE [Count by amount]: each signal means a fixed amount,
/// `standardQuantity` (e.g. an encoder firing every 100 ft); the speed is a rate.
/// QUANTITY_PER_INTERVAL [Count by time]: signals come on a fixed clock of
/// `standardCycle` seconds and the amount in each one varies; it is measured
/// against the expected amount (rate × interval).
enum CycleMode {
  DISCRETE
  QUANTITY_PER_CYCLE
  QUANTITY_PER_INTERVAL
}

enum DowntimeDetectUnit {
  SECONDS
}

enum SlowDetectUnit {
  PERCENTAGE
}

model StationVersion {
  id      String @id @default(uuid()) @db.Uuid
  version Int

  standardCycle         Decimal?           @db.Decimal(10, 2)
  cycleMode             CycleMode          @default(DISCRETE)
  /// Standard quantity per cycle event (e.g. encoder fires every 100 ft); null = discrete.
  standardQuantity      Decimal?           @db.Decimal(18, 4)
  /// The station's canonical unit for all quantities (standards, actuals, inventory).
  quantityUnit          String             @default("")
  /// Station default rate (e.g. 100 rivets per MINUTE); JobVersion rate overrides.
  standardRate          Decimal?           @db.Decimal(18, 4)
  standardRateUnit      String             @default("")
  standardRatePeriod    RatePeriod         @default(MINUTE)
  inLineCalculations    Boolean            @default(false)
  inStationCalculations Boolean            @default(false)
  downtimeDetect        Decimal?           @db.Decimal(10, 2)
  downtimeDetectUnit    DowntimeDetectUnit @default(SECONDS)
  slowDetect            Decimal?           @db.Decimal(10, 2)
  slowDetectUnit        SlowDetectUnit     @default(PERCENTAGE)

  /// The profile this station follows (ADR-0017). When set, cycleMode,
  /// quantityUnit, standardQuantity and (count by time) standardCycle are
  /// copies of the profile, made by the service; null = set by hand.
  profileId        String?         @db.Uuid
  profile          StationProfile? @relation(fields: [profileId], references: [id], onDelete: NoAction)
  /// true = the speed fields are the profile's usual speed and follow it when
  /// the profile changes; false = the station's own speed.
  speedFromProfile Boolean         @default(false)

  stationId String  @db.Uuid
  station   Station @relation("StationVersions", fields: [stationId], references: [id], onDelete: Cascade)

  currentOfStation    Station?             @relation("StationCurrent")
  cycles              Cycle[]
  stateLogs           StationStateLog[]
  itemDispositionLogs ItemDispositionLog[]
  calls               Call[]
  modeLogs            StationModeLog[]

  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@unique([stationId, version])
  @@index([stationId])
  @@index([profileId])
}
