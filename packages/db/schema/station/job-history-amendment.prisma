enum JobHistoryAmendmentStatus {
  PENDING_REBUILD
  APPLIED
  FAILED
}

/// A retroactive correction of which job a station ran over [fromTime, toTime).
/// The facts (job log, cycles, items, state log, calls, mode logs) are rewritten
/// in the same transaction; metric buckets are rebuilt asynchronously and the
/// status tracks that rebuild.
model JobHistoryAmendment {
  id String @id @default(uuid()) @db.Uuid

  siteId String @db.Uuid
  site   Site   @relation(fields: [siteId], references: [id], onDelete: Cascade)

  stationId String  @db.Uuid
  station   Station @relation(fields: [stationId], references: [id], onDelete: Cascade)

  /// null = the station ran no job over the window.
  jobId        String? @db.Uuid
  job          Job?    @relation(fields: [jobId], references: [id], onDelete: SetNull)
  jobVersionId String? @db.Uuid

  fromTime DateTime  @db.Timestamptz(3)
  /// null = through now; the amendment also changed Station.currentJobId.
  toTime   DateTime? @db.Timestamptz(3)

  /// StationJobLog rows that overlapped the window before the rewrite.
  previousTimeline Json
  /// Row counts touched per module.
  summary          Json @default("{}")

  status       JobHistoryAmendmentStatus @default(PENDING_REBUILD)
  rebuildError String?
  rebuiltAt    DateTime?                 @db.Timestamptz(3)

  source          ActionSource @default(MANUAL)
  actorEmployeeId String?      @db.Uuid
  actorUserId     String?      @db.Uuid

  /// Cycles whose job this amendment rewrote, and the items it recreated.
  cycles  Cycle[]
  items   InventoryItem[]
  jobLogs StationJobLog[]

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@index([stationId, createdAt])
  @@index([siteId, status])
}
