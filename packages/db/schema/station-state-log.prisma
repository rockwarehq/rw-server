enum StationState {
  UP
  DOWN
}

enum StationStatus {
  FAST
  SLOW
  UP
  DOWN
}

model StationStateLog {
  id        String       @id @default(uuid()) @db.Uuid
  startTime DateTime     @db.Timestamptz(3)
  endTime   DateTime?    @db.Timestamptz(3)
  state     StationState
  blockId   String

  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @db.Timestamptz(3)
  deletedAt DateTime? @db.Timestamptz(3)

  stationId String  @db.Uuid
  station   Station @relation(fields: [stationId], references: [id], onDelete: Cascade)

  // ── Dimension snapshots (star pattern for BI), captured when the row opens ──
  siteId String? @db.Uuid
  site   Site?   @relation(fields: [siteId], references: [id], onDelete: Cascade)

  workcenterId String?     @db.Uuid
  workcenter   Workcenter? @relation(fields: [workcenterId], references: [id], onDelete: SetNull)

  /// Stable job id paired with the jobVersionId snapshot below.
  jobId String? @db.Uuid
  job   Job?    @relation(fields: [jobId], references: [id], onDelete: SetNull)

  /// Shift the period started in.
  shiftInstanceId String?        @db.Uuid
  shiftInstance   ShiftInstance? @relation(fields: [shiftInstanceId], references: [id], onDelete: SetNull)
  /// Mirrors ShiftInstance.isScheduled at write time (ADR-0015): false = the
  /// shift stamped here was unscheduled time. Re-stamped by shift amendments.
  isScheduled     Boolean        @default(true)

  /// Business date of that shift.
  businessDate DateTime? @db.Date

  stationVersionId String?         @db.Uuid
  stationVersion   StationVersion? @relation(fields: [stationVersionId], references: [id])

  jobVersionId String?     @db.Uuid
  jobVersion   JobVersion? @relation(fields: [jobVersionId], references: [id])

  status         StationStatus?
  statusReasonId String?        @db.Uuid
  statusReason   StatusReason?  @relation(fields: [statusReasonId], references: [id], onDelete: SetNull)
  /// Whether this period counts as planned downtime: stamped from the reason when it is
  /// assigned and editable per period, so later reason edits do not rewrite history.
  isPlannedDown  Boolean        @default(false)

  /// Production mode the station was in during this status period.
  modeId String?         @db.Uuid
  mode   ProductionMode? @relation(fields: [modeId], references: [id], onDelete: SetNull)

  @@index([stationId])
  @@index([stationId, endTime])
  @@index([stationId, startTime])
  // Historian delta scans (ADR 0008): changes are fetched by change-timestamp
  // watermark, so the poll loop needs an updatedAt-leading index per station.
  @@index([stationId, updatedAt])
  @@index([statusReasonId])
  @@index([jobVersionId])
  @@index([siteId, businessDate])
  @@index([shiftInstanceId])
  @@index([workcenterId])
}
