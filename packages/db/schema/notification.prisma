/// Admin-defined, per-site group of employees notified together. Channels are
/// chosen on the group so senders (automations) never know about email vs SMS.
model NotificationGroup {
  id          String                @id @default(uuid()) @db.Uuid
  name        String
  description String?
  channels    NotificationChannel[] @default([EMAIL])

  members Employee[] @relation("NotificationGroupMembers")

  siteId String @db.Uuid
  site   Site   @relation(fields: [siteId], references: [id], onDelete: Cascade)

  notifications Notification[]

  createdAt  DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime  @updatedAt @db.Timestamptz(3)
  archivedAt DateTime? @db.Timestamptz(3)

  @@unique([siteId, name])
  @@index([siteId])
}

enum NotificationChannel {
  EMAIL
  SMS
}

enum NotificationDeliveryStatus {
  SENT
  FAILED
  /// Not attempted: the employee has no address for the channel, or the channel has no provider.
  SKIPPED
}

/// One send request: what was asked, by whom, to which groups and/or people.
/// Who received it and whether the provider accepted it is the deliveries.
model Notification {
  id String @id @default(uuid()) @db.Uuid

  siteId String @db.Uuid
  site   Site   @relation(fields: [siteId], references: [id], onDelete: Cascade)

  /// First group targeted (null for a direct-to-people send); groupName snapshots every group name.
  groupId   String?            @db.Uuid
  group     NotificationGroup? @relation(fields: [groupId], references: [id], onDelete: SetNull)
  groupName String?

  subject String
  body    String

  source     ActionSource @default(SYSTEM)
  sourceType String? // programmatic origin discriminator, e.g. "automation"
  sourceRef  String? // free-form correlation id (automation id, ...)
  /// Caller-supplied idempotency key (e.g. automation eventId + action index); a repeat returns the original.
  dedupeKey  String?      @unique

  deliveries NotificationDelivery[]

  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@index([siteId, createdAt(sort: Desc)])
  @@index([groupId])
}

/// One row per recipient per channel: the address used and the outcome.
model NotificationDelivery {
  id String @id @default(uuid()) @db.Uuid

  notificationId String       @db.Uuid
  notification   Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  employeeId String?   @db.Uuid
  employee   Employee? @relation(fields: [employeeId], references: [id], onDelete: SetNull)

  channel           NotificationChannel
  address           String? // email / phone used; null when the employee had none
  status            NotificationDeliveryStatus
  error             String?
  providerMessageId String?

  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@index([notificationId])
  @@index([employeeId])
}

// ── SMS consent ──────────────────────────────────────────────────────────
// Keyed by phone number, not person: carriers track STOP by number, and a number can outlive
// the employee record it was typed on. No row means nobody ever asked, which is not OPTED_OUT.

enum SmsConsentStatus {
  OPTED_IN
  OPTED_OUT
}

/// How a decision was captured; A2P 10DLC requires the method on file, not just the answer.
enum SmsConsentMethod {
  WEB_FORM /// Ticked (or unticked) a consent box in the app
  VERBAL /// Told a supervisor, who recorded it
  PAPER /// Signed form on file
  TEXT_KEYWORD /// Texted a join keyword to the number
  STOP_KEYWORD /// Replied STOP; the carrier and Twilio enforce this independently
  IMPORTED /// Carried over from a prior system
}

/// Current consent for one number per workspace; `events` is the history behind it.
model SmsConsent {
  id String @id @default(uuid()) @db.Uuid

  workspaceId String    @db.Uuid
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  /// E.164; reads normalize too, so a hand-typed profile number still matches.
  phone String

  status SmsConsentStatus
  method SmsConsentMethod
  /// When the CURRENT status was decided (not when the row was last touched).
  statusAt DateTime @default(now()) @db.Timestamptz(3)

  events SmsConsentEvent[]

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@unique([workspaceId, phone])
  @@index([workspaceId, status])
}

/// Append-only history: the proof a text was permitted when it was sent.
model SmsConsentEvent {
  id String @id @default(uuid()) @db.Uuid

  consentId String     @db.Uuid
  consent   SmsConsent @relation(fields: [consentId], references: [id], onDelete: Cascade)

  status SmsConsentStatus
  method SmsConsentMethod

  /// MANUAL = a person recorded it in the app; SYSTEM = Twilio/carrier told us (STOP).
  source ActionSource @default(MANUAL)
  /// The signed-in user who recorded it, when there was one.
  actorUserId String? @db.Uuid
  actor       User?   @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  /// Free text: where a paper form is filed, what the person actually said, ...
  note String?

  /// rw-hub event this was replicated from; unique per consent row, since one event lands once
  /// per workspace holding the number.
  relayEventId String?

  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@unique([consentId, relayEventId])
  @@index([consentId, createdAt(sort: Desc)])
}

/// Where the rw-hub poll left off. One row: the hub knows tenants, not workspaces.
model HubCursor {
  id     String @id @default("singleton")
  cursor String @default("0")

  updatedAt DateTime @updatedAt @db.Timestamptz(3)
}
