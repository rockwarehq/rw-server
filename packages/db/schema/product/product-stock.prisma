/// RETIRED (ADR-0016): nothing reads or writes this table any more. On-hand
/// stock now lives in StockBalance, built from the StockMovement book. The
/// table stays for one release so servers still running the old code keep
/// working while a deploy rolls out. A later migration drops it.
model ProductStock {
  siteId String @db.Uuid
  site   Site   @relation(fields: [siteId], references: [id], onDelete: Cascade)

  productId String  @db.Uuid
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  produced   Decimal @default(0) @db.Decimal(18, 4)
  scrapped   Decimal @default(0) @db.Decimal(18, 4)
  consumed   Decimal @default(0) @db.Decimal(18, 4)
  /// Backed by ProductStockAdjustment: SUM(delta) — rebuildable like the
  /// other fact columns.
  adjustment Decimal @default(0) @db.Decimal(18, 4)

  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@id([siteId, productId])
}
