/// The account. Each deployment has exactly one: `singletonGuard` is
/// always 0 and unique, so a second row cannot be inserted (the same guard
/// Basecamp's single-tenant Campfire puts on its accounts table). Users
/// carry no workspace column; the one workspace is implied.
model Workspace {
  id             String  @id @default(uuid()) @db.Uuid
  /// Always 0. Unique, so the table holds one row.
  singletonGuard Int     @unique @default(0)
  name           String  @unique
  slug           String  @unique
  description    String?
  isDefault      Boolean @default(false) // Left over from many workspaces; always one now
  settings       Json    @default("{}")

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  // ARCHIVED (pre-account-admin model)
  memberships WorkspaceMembership[]

  // ARCHIVED (Location replaced by Site)
  locations Location[]

  // Sites owned by this workspace
  sites Site[]

  // Employee profiles owned by this workspace
  employees Employee[]

  // Access-control containers
  buckets Bucket[]

  // ARCHIVED (pre-bucket model)
  roles Role[]

  // Shared object schemas owned by this workspace
  objectSchemas ObjectSchema[]

  // Customer/app API tokens issued for this workspace
  apiTokens ApiToken[]

  // SMS consent, keyed by phone number rather than by person
  smsConsents SmsConsent[]
}

/// ARCHIVED — was the membership's standing; now User.isAccountAdmin.
enum WorkspaceRole {
  OWNER
  MEMBER
}

/// ARCHIVED — one workspace per deployment made memberships redundant.
/// Their data moved to User (isAccountAdmin, employeeId) and
/// BucketAccess.userId. Kept as a frozen archive with RoleAssignment and
/// WorkcenterGrant, which still point here. NO code reads or writes it.
model WorkspaceMembership {
  id String @id @default(uuid()) @db.Uuid

  joinedAt  DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  workspaceId String    @db.Uuid
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  employeeId String? @db.Uuid

  workspaceRole WorkspaceRole @default(MEMBER)

  // ARCHIVED relations (pre-bucket model; no code paths).
  roleAssignments  RoleAssignment[]
  workcenterGrants WorkcenterGrant[]

  @@unique([userId, workspaceId])
  @@unique([workspaceId, employeeId])
  @@index([workspaceId])
  @@map("WorkspaceMember")
}

model Site {
  id          String  @id @default(uuid()) @db.Uuid
  name        String
  description String?
  timezone    String  @default("UTC")
  attrs       Json    @default("{}")

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  // Workspace ownership (required)
  workspaceId String    @db.Uuid
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  // Children
  workcenters             Workcenter[]
  gateways                Gateway[]
  datasources             Datasource[]
  stations                Station[]
  cycles                  Cycle[]
  products                Product[]
  materials               Material[]
  tools                   Tool[]
  jobs                    Job[]
  orders                  WorkOrder[] // ARCHIVED
  shiftPattern            ShiftPattern[]
  shiftAssignment         ShiftAssignment[]
  shiftInstances          ShiftInstance[]
  shiftOverrides          ShiftOverride[]
  shiftAmendments         ShiftAmendment[]
  labels                  Label[]
  statusReasons           StatusReason[]
  metricBuckets           MetricBucket[]
  metricBucketLogs        MetricBucketLog[]
  toolStatuses            ToolStatus[] // ARCHIVED
  toolLocations           ToolLocation[] // ARCHIVED
  dashboards              Dashboard[]
  displays                Display[]
  documents               Document[]
  andonRules              SiteAndonRule[]
  statusCategories        StatusCategory[]
  itemDispositions        ItemDisposition[]
  itemDispositionReason   ItemDispositionReason[]
  itemDispositionLogs     ItemDispositionLog[]
  employeeRoles           EmployeeRole[]
  employeeSiteAccess      EmployeeSiteAccess[]
  customers               Customer[]
  fulfillmentOrders       Order[]                  @relation("SiteFulfillmentOrders")
  productStocks           ProductStock[]
  orderConsumptions       OrderConsumption[]
  productStockAdjustments ProductStockAdjustment[]
  shiftComments           ShiftComment[]
  shiftSignoffs           ShiftSignoff[]
  buckets                 Bucket[]
  roleAssignments         RoleAssignment[] // ARCHIVED
  materialLedgerEntries   MaterialLedgerEntry[]
  materialShiftUsage      MaterialShiftUsage[]
  graphNodes              GraphNode[]
  graphNodeTypes          GraphNodeType[]
  graphHooks              GraphHook[]
  objectSchemas           ObjectSchema[]
  objectInstances         ObjectInstance[]
  apiTokens               ApiToken[]
  savedViews              SavedView[]
  integrations            Integration[]
  integrationTriggers     IntegrationTrigger[]
  callDefinitions         CallDefinition[]
  calls                   Call[]
  productionModes         ProductionMode[]
  automations             Automation[]
  notificationGroups      NotificationGroup[]
  notifications           Notification[]
  stationModeLogs         StationModeLog[]
  inventoryItems          InventoryItem[]
  stationStateLogs        StationStateLog[]
  stationJobLogs          StationJobLog[]
  jobHistoryAmendments    JobHistoryAmendment[]
  stationLogonSessions    StationLogonSession[]

  @@unique([workspaceId, name])
  @@index([workspaceId])
}

/// Assignment (implicit m2m): links site-wide status reasons to Workcenters and Stations
model StatusReason {
  id            String  @id @default(uuid()) @db.Uuid
  name          String
  isPlannedDown Boolean @default(false)

  createdAt  DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime  @updatedAt @db.Timestamptz(3)
  archivedAt DateTime? @db.Timestamptz(3)

  siteId String @db.Uuid
  site   Site   @relation(fields: [siteId], references: [id], onDelete: Cascade)

  categoryId String?         @db.Uuid
  category   StatusCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  labels          Label[]
  stateLogs       StationStateLog[]
  workcenters     Workcenter[]
  stations        Station[]
  productionModes ProductionMode[]

  @@unique([siteId, name])
  @@index([siteId])
  @@index([categoryId])
}

/// Used in (StatusReason) to group like reasons
model StatusCategory {
  id   String @id @default(uuid()) @db.Uuid
  name String

  createdAt  DateTime  @default(now()) @db.Timestamptz(3)
  archivedAt DateTime? @db.Timestamptz(3)
  updatedAt  DateTime  @updatedAt @db.Timestamptz(3)
  deletedAt  DateTime? @db.Timestamptz(3)

  siteId String @db.Uuid
  site   Site   @relation(fields: [siteId], references: [id], onDelete: Cascade)

  statusReasons StatusReason[]

  @@unique([siteId, name])
  @@index([siteId])
}
