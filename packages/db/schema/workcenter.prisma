model Workcenter {
  id          String  @id @default(uuid()) @db.Uuid
  name        String
  description String?
  attrs       Json    @default("{}")

  /// Detection defaults for the workcenter's stations; a station's own value
  /// (StationVersion) overrides. Null = none here. Same units as the station's:
  /// slow/fast are fractions of the standard cycle (0.25 = 25%), down is seconds
  /// past the standard cycle.
  slowDetect     Decimal? @db.Decimal(10, 2)
  fastDetect     Decimal? @db.Decimal(10, 2)
  downtimeDetect Decimal? @db.Decimal(10, 2)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  // Site ownership (required)
  siteId String @db.Uuid
  site   Site   @relation(fields: [siteId], references: [id], onDelete: Cascade)

  // Self-referential hierarchy
  parentId String?      @db.Uuid
  parent   Workcenter?  @relation("WorkcenterHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children Workcenter[] @relation("WorkcenterHierarchy")

  // Relations
  stations            Station[]
  reportDecks         ReportDeck[]
  shiftAssignment     ShiftAssignment[]
  shiftInstances      ShiftInstance[]
  shiftOverrides      ShiftOverride[]
  shiftAmendments     ShiftAmendment[]
  statusReasons       StatusReason[]
  displays            Display[]
  itemDispositionLogs ItemDispositionLog[]
  shiftComments       ShiftComment[]
  signoffs            ShiftSignoff[]
  calls               Call[]
  modeLogs            StationModeLog[]
  cycles              Cycle[]
  inventoryItems      InventoryItem[]
  stateLogs           StationStateLog[]
  jobLogs             StationJobLog[]
  logonSessions       StationLogonSession[]
  materialShiftUsage  MaterialShiftUsage[]
  bucket              Bucket?

  @@unique([siteId, parentId, name])
  @@index([siteId])
  @@index([parentId])
}
