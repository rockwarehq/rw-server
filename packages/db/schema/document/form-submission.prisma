/// One filled-in FORM. It pins the PUBLISHED version it was filled against
/// and records where the work happened: the station (when given), its
/// workcenter and the job it ran at submit time.
model FormSubmission {
  id     String @id @default(uuid()) @db.Uuid
  /// Per-document sequence: 1, 2, 3…
  number Int

  documentId String   @db.Uuid
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  /// NoAction (not Restrict) so deleting the document can cascade through
  /// both its versions and its submissions in one statement.
  formId String       @db.Uuid
  form   DocumentForm @relation(fields: [formId], references: [id], onDelete: NoAction)

  /// { [fieldId]: answer }, checked against the pinned version's manifest.
  answers Json

  siteId       String?     @db.Uuid
  site         Site?       @relation(fields: [siteId], references: [id], onDelete: SetNull)
  workcenterId String?     @db.Uuid
  workcenter   Workcenter? @relation(fields: [workcenterId], references: [id], onDelete: SetNull)
  stationId    String?     @db.Uuid
  station      Station?    @relation(fields: [stationId], references: [id], onDelete: SetNull)
  jobId        String?     @db.Uuid
  job          Job?        @relation(fields: [jobId], references: [id], onDelete: SetNull)

  submittedById String?  @db.Uuid
  submittedBy   User?    @relation(fields: [submittedById], references: [id], onDelete: SetNull)
  submittedAt   DateTime @default(now()) @db.Timestamptz(3)

  /// The records this submission made in IMM (scrap, shift notes, entity
  /// instances), each linked back to it.
  writes FormSubmissionWrite[]

  @@unique([documentId, number])
  @@index([documentId, submittedAt])
  @@index([stationId])
  @@index([formId])
}

enum FormWriteKind {
  SCRAP
  SHIFT_NOTE
  ENTITY
}

/// One record a submission wrote on submit, from the field that configured it.
/// targetId is the written row (ItemDispositionLog, ShiftComment or
/// ObjectInstance, by kind); no foreign key, since the kinds differ.
model FormSubmissionWrite {
  id           String         @id @default(uuid()) @db.Uuid
  submissionId String         @db.Uuid
  submission   FormSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  fieldId      String
  kind         FormWriteKind
  targetId     String         @db.Uuid
  /// What it is, for people: "Scrap · 3 · Short shot", "Shift note"…
  label        String
  createdAt    DateTime       @default(now()) @db.Timestamptz(3)

  @@index([submissionId])
  @@index([kind, targetId])
}
