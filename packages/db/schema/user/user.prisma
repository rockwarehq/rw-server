/// Internal Rockware staff. Users with a SystemRole get access from code
/// (SUPPORT = read everywhere, ENGINEER = manage/admin everywhere). They
/// hold no bucket access and are not account admins.
enum SystemRole {
  SUPPORT
  ENGINEER
}

enum UserStatus {
  PENDING // Invited but hasn't set password
  ACTIVE // Can log in
  DISABLED // Administratively disabled
}

model User {
  id           String     @id @default(uuid()) @db.Uuid
  email        String     @unique
  passwordHash String? // Null until invited/registered
  /// @deprecated Use the employee profile.
  firstName    String?
  /// @deprecated Use the employee profile.
  lastName     String?
  avatarKey    String? // S3 key for the account avatar; null = initials fallback
  status       UserStatus @default(PENDING)

  // Invite flow - invitees receive a temporary password (bcrypt in
  // passwordHash) and must change it at first login. inviteTokenExpiry
  // bounds how long an unaccepted invite can still log in.
  inviteTokenExpiry DateTime? @db.Timestamptz(3)
  invitedBy         String?   @db.Uuid
  invitedAt         DateTime? @db.Timestamptz(3)

  // Password reset - short emailed codes stored as SHA256 hashes.
  // Codes are looked up by email, so the hash needs no unique index.
  resetTokenHash   String?
  resetTokenExpiry DateTime? @db.Timestamptz(3)
  resetAttempts    Int       @default(0) // Brute-force protection

  // Login lockout
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime? @db.Timestamptz(3)

  // Set when an admin issues a temporary password. While true, the API
  // blocks everything except password change and session endpoints.
  mustChangePassword Boolean @default(false)

  // Internal Rockware staff marker. When set, access resolves from code
  // (SUPPORT reads everywhere, ENGINEER manages everywhere) and the user
  // holds no bucket access and is not an account admin.
  systemRole SystemRole?

  // Account admin: skips buckets and runs the account (sites, people,
  // settings). Only an account admin can make another one.
  isAccountAdmin Boolean @default(false)

  // The employee profile this login belongs to (a supervisor who also
  // works the floor). One user per employee.
  employeeId String?   @unique @db.Uuid
  employee   Employee? @relation(fields: [employeeId], references: [id], onDelete: SetNull)

  lastLoginAt DateTime? @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @db.Timestamptz(3)

  // Relations
  bucketAccesses          BucketAccess[]
  refreshTokens           RefreshToken[]
  shiftComments           ShiftComment[]
  shiftSignoffsPosted     ShiftSignoff[]           @relation("ShiftSignoffPostedBy")
  shiftSignoffsReopened   ShiftSignoff[]           @relation("ShiftSignoffReopenedBy")
  shiftAmendments         ShiftAmendment[]
  materialLedgerEntries   MaterialLedgerEntry[]
  productStockAdjustments ProductStockAdjustment[]
  apiTokensCreated        ApiToken[]
  savedViewsCreated       SavedView[]

  // SMS consent decisions this user recorded
  smsConsentEvents SmsConsentEvent[]
}
