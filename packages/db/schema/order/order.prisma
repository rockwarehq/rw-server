/// An order is raised OPEN, then either COMPLETED — consuming covered stock and
/// writing the OrderConsumption ledger — or CANCELLED, closing without
/// consuming. Both are terminal.
enum OrderStatus {
  OPEN
  COMPLETED
  CANCELLED
}

model Order {
  id                    String      @id @default(uuid()) @db.Uuid
  orderNumber           String
  status                OrderStatus @default(OPEN)
  /// Manual fill-queue position: the FIFO key coverage walks. Assigned at
  /// creation, rewritten wholesale by `reorder`.
  sequence              Int?
  notes                 String?
  poNumber              String?
  defaultTargetQuantity Decimal     @default(1) @db.Decimal(18, 4)
  startDate             DateTime?   @db.Timestamptz(3)
  dueDate               DateTime?   @db.Timestamptz(3)

  /// When the order was raised. Every order is created OPEN, so this is
  /// stamped once at creation and never moves.
  openedAt    DateTime? @db.Timestamptz(3)
  /// When the order was completed. Unlike `updatedAt`, it does not move when
  /// something else touches the row.
  completedAt DateTime? @db.Timestamptz(3)
  /// When the order was cancelled. COMPLETED and CANCELLED are terminal and
  /// mutually exclusive, so at most one of these two is ever set.
  cancelledAt DateTime? @db.Timestamptz(3)

  /// Who raised the order. Null for rows created before this column and for
  /// any non-interactive creator.
  createdByUserId String? @db.Uuid

  siteId String @db.Uuid
  site   Site   @relation("SiteFulfillmentOrders", fields: [siteId], references: [id])

  customerId String?   @db.Uuid
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  lineItems    OrderLineItem[]
  consumptions OrderConsumption[]

  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @db.Timestamptz(3)
  deletedAt DateTime? @db.Timestamptz(3)

  @@unique([siteId, orderNumber])
  @@index([siteId, status])
  @@index([siteId, sequence])
  @@index([siteId, completedAt])
  @@index([customerId])
}
