HOST=::
PORT=30200
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/rw_server
NATS_URL=nats://127.0.0.1:4222
NATS_CLIENT_NAME=rw-sim

# Where the simulator keeps its config (a Fly volume in deployed tenants)
SIM_CONFIG_PATH=./data/sim.json
# How often stations, jobs and standards are re-read from the DB
SIM_DISCOVERY_MS=15000
# Platform API — the UI signs in with your Rockware account through it
SIM_API_URL=http://localhost:3000
