# apps/api — HTTP/RPC/auth server + in-process workers
# (stale-gateway-check, replay-reconcile, station-detect, dev-cycle-simulator)
#
# Copy to apps/api/.env and fill in. In production these come from `fly secrets`.

# ── runtime
NODE_ENV=development
LOG_LEVEL=debug
NODE_ID=gateway-001
HOST=0.0.0.0
PORT=30000
CLOSE_GRACE_DELAY=500
# How long shutdown waits for in-flight work before exiting (ms).
# DRAIN_TIMEOUT_MS=25000
# Set by Fly on each machine; names this process in agent run leases. Don't set by hand.
# FLY_MACHINE_ID=
# The process clock is always UTC (main.ts sets TZ=UTC); don't set TZ.

# ── database
# DATABASE_URL = pooled (pgbouncer transaction mode) endpoint — used at runtime
# DATABASE_URL_MIGRATION = direct endpoint — used by `prisma migrate` (sessions,
#                          advisory locks, DDL require a real connection).
#                          Also consumed by fly's [deploy] release_command.
# In dev with self-hosted Postgres, both can point at the same URL. In prod
# against PSDB / Supabase / Neon, set them to the pooled and direct endpoints
# respectively.
DATABASE_URL=postgres://postgres:postgres@localhost:6432/rockware
DATABASE_URL_MIGRATION=postgres://postgres:postgres@localhost:5432/rockware
# Connections per process. Default by role (api 5); keep the total across all
# processes within the database's limit.
# DB_POOL_SIZE=5

# ── redis (same value in apps/workers/.env)
REDIS_URL=redis://localhost:6379

# ── nats (graph definition events to livestore)
# Unset or empty = graph definition publishing disabled, API writes still succeed.
NATS_URL=nats://127.0.0.1:4222
# NATS_CLIENT_NAME=rw-api
# Relay credentials handed to gateways in /edge/connect: their local leaf node
# connects out to the cloud cluster with these. Comma-separated servers;
# empty = gateways get no relay.
# NATS_GATEWAY_RELAY_SERVERS=nats://relay.example:7422
# NATS_GATEWAY_RELAY_USER=
# NATS_GATEWAY_RELAY_PASS=

# ── auth
JWT_SECRET=replace-with-strong-secret
# The iss claim on tokens this API signs.
# JWT_ISSUER=rw-api

# ── integration credentials
# 32 bytes as 64 hex characters, sealing stored integration credentials.
# Required in production. Losing it makes every stored credential
# unrecoverable: back it up WITH the database. Generate: openssl rand -hex 32
# INTEGRATION_ENCRYPTION_KEY=

# ── processor-shared secret (signs callbacks between api and workers/processor)
PROCESSOR_SHARED_SECRET=replace-with-strong-secret

# ── email (Resend)
# RESEND_API_KEY=re_xxxxxxxxxxxx
EMAIL_FROM=noreply@notify.rockware.io

# ── support (Chatwoot)
# Identity Validation token: Chatwoot → Inboxes → the website inbox → Settings →
# Configuration → Identity Validation. Unset = /users/me supportSignature is null.
# SUPPORT_IDENTITY_SECRET=xxxxxxxxxxxx

# ── sms (via rw-hub, which holds the Twilio credentials) — optional. Unset = SMS records SKIPPED.
# Issue the key with `pnpm tenant key issue <slug>` in the rw-hub repo.
# HUB_URL=https://hub.rockware.io
# HUB_API_KEY=rwh_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Browser-facing base URL: email links + CORS allowlist. Required (https) in production.
APP_BASE_URL=http://localhost:3000
# Extra allowed browser origins, comma-separated, additive to APP_BASE_URL.
# In development, leaving this unset allows all origins.
# CORS_ALLOWED_ORIGINS=https://staging.rockware.io
# Any origin may call the API (default true: auth is Bearer-only, and the
# desktop and kiosk apps send Origin: null). false = APP_BASE_URL +
# CORS_ALLOWED_ORIGINS only.
# CORS_ALLOW_ANY=true

# ── S3 / object storage (optional — file uploads)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1
# AWS_ENDPOINT_URL_S3=https://fly.storage.tigris.dev
# BUCKET_NAME=
# DOCUMENT_MAX_FILE_SIZE_BYTES=52428800
# DOCUMENT_ALLOWED_CONTENT_TYPES=application/pdf,text/plain,text/markdown,text/csv,application/json,image/jpeg,image/png,image/webp,image/gif,image/svg+xml,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document,application/vnd.ms-excel,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet,application/vnd.ms-powerpoint,application/vnd.openxmlformats-officedocument.presentationml.presentation



# ── processor cache refresh callback (optional — api → workers/processor)
# PROCESSOR_CACHE_REFRESH_URL=http://localhost:9465/internal/cache/refresh
# PROCESSOR_CACHE_REFRESH_SECRET=
# PROCESSOR_CACHE_REFRESH_TIMEOUT_MS=2000

# ── station actions (optional)
# STATION_ACTION_WEBHOOK_TIMEOUT_MS=5000

# ── bullmq tuning (optional — defaults work for standard Redis)
# BULLMQ_STALLED_INTERVAL=30000
# BULLMQ_DRAIN_DELAY=5000
# BULLMQ_CONNECT_TIMEOUT=10000

# ── agents (Console AI, agent runs, triggers, MCP) — in development
# Off unless set to true: off hides the whole agent surface and starts none of
# its services. On without a key, Console shows agents as not configured.
# AGENTS_ENABLED=true
# ANTHROPIC_API_KEY=
# AGENT_MODEL=claude-opus-5
# Record why each request missed the prompt cache on step.finished events.
# AGENT_CACHE_DIAGNOSTICS=true

# ── connected agents (people's own Claude Code, Codex, ChatGPT, ... over MCP + OAuth)
# Off unless true. Mounts /mcp and the OAuth routes and admits connected agents.
# Independent of AGENTS_ENABLED. Each plant still opts in (Settings → Connect
# an agent in IMM, off by default). The consent page and review links use
# APP_BASE_URL, so that must be IMM's URL.
# MCP_ENABLED=true
# The API's public https origin, for OAuth metadata and the issuer. Unset =
# read from forwarded headers. Set it when the proxy doesn't forward the public
# host and proto: ChatGPT checks the issuer string exactly.
# MCP_PUBLIC_URL=https://api.example.rockware.io
# Hosts files attached in a chat may be downloaded from (ChatGPT passes
# attachments as links). Comma-separated; "*." matches subdomains.
# MCP_FILE_HOSTS=*.oaiusercontent.com

# ── seed (pnpm db:seed)
# The first admin the seed creates. Both required in production, and the
# password must be 12+ characters; development defaults to admin@example.com.
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=

# ── dev-only
# DEV_CYCLE_SIMULATOR=1
# DEV_CYCLE_SIMULATOR_INTERVAL_MS=10000

# ── tests
# Tier 2 integration tests (auth flows against a real DB) run only when this
# is set; vitest's global setup migrates + seeds it. Use a scratch database.
# TEST_DATABASE_URL=postgres://user:pass@localhost:5432/rw_api_test
