HOST=::
PORT=30100
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/rw_server
NATS_URL=nats://127.0.0.1:4222
NATS_CLIENT_NAME=rw-livestore
# Prometheus metrics port.
# METRICS_PORT=9091

# Stream sizing (optional; defaults shown)
# NATS_AGG_MAX_BYTES=33554432
# NATS_CVG_MAX_BYTES=134217728
# Tag stream: keep an hour of tags, up to 128 MB.
# NATS_TAGS_MAX_AGE_NANOS=3600000000000
# NATS_TAGS_MAX_BYTES=134217728
# Source tags from another JetStream domain's stream (e.g. a leaf node).
# Unset domain = the local TAGS stream.
# NATS_TAGS_SOURCE_DOMAIN=
# NATS_TAGS_SOURCE_STREAM=TAGS

# Tag fixture helpers
GRAPH_DEVICE_ID=press7-plc
GRAPH_TAG_PATH=cycleTime
GRAPH_NODE_NAME=Press 7
GRAPH_PROPERTY_NAME=cycleTime

# simulate-metrics harness
SIM_STATIONS=5
SIM_INTERVAL_MS=1000

# simulate-tags harness; defaults to all datasources with a site, including DRAFT
SIM_TAG_INTERVAL_MS=1000
# SIM_TAG_DATASOURCE_IDS=00000000-0000-0000-0000-000000000000
# SIM_TAG_SITE_ID=00000000-0000-0000-0000-000000000000
# SIM_TAG_GATEWAY_ID=00000000-0000-0000-0000-000000000000
# SIM_TAG_POINT_IDS=00000000-0000-0000-0000-000000000000
# SIM_TAG_QUALITY=good
# SIM_TAG_INCLUDE_DRAFT=true
